<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Elite Valute - Personalized Elegance in Every Bag</title>

<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">

<style>
:root {
  --black:#1a1a1a;
  --white:#fff;
  --beige:#f8f4f0;
  --gold:#d4af37;
}

body{
  margin:0;
  font-family:'Inter',sans-serif;
  color:var(--black);
}

h1,h2{
  font-family:'Playfair Display',serif;
}

/* NAV */
nav{
  display:flex;
  justify-content:space-between;
  padding:20px;
  background:#fff;
  position:fixed;
  width:100%;
  top:0;
}

.logo{
  font-size:24px;
  font-weight:600;
}

.menu a{
  margin:0 10px;
  text-decoration:none;
  color:#000;
}

/* HERO */
.hero{
  padding-top:120px;
  text-align:center;
  background:var(--beige);
  padding-bottom:80px;
}

.hero h1{
  font-size:48px;
}

.btn{
  padding:12px 25px;
  background:var(--gold);
  border:none;
  border-radius:30px;
  margin-top:20px;
  cursor:pointer;
}

/* PRODUCTS */
.products{
  padding:60px 20px;
  text-align:center;
}

.grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
  gap:20px;
}

.card{
  border:1px solid #eee;
  padding:20px;
  border-radius:15px;
}

/* FOOTER */
footer{
  background:#000;
  color:#fff;
  text-align:center;
  padding:30px;
}
</style>
</head>

<body>

<nav>
  <div class="logo">Elite Valute</div>
  <div class="menu">
    <a href="#">Home</a>
    <a href="#">Shop</a>
    <a href="#">Categories</a>
    <a href="#">Contact</a>
  </div>
</nav>

<section class="hero">
  <h1>Personalized Elegance in Every Bag</h1>
  <p>Luxury monogrammed bags for modern women</p>
  <button class="btn">Shop Now</button>
</section>

<section class="products">
  <h2>Featured Products</h2>
  <div class="grid">
    <div class="card">
      <h3>Tote Bag</h3>
      <p>$49</p>
    </div>
    <div class="card">
      <h3>Handbag</h3>
      <p>$79</p>
    </div>
    <div class="card">
      <h3>Travel Bag</h3>
      <p>$99</p>
    </div>
  </div>
</section>

<footer>
  <p>© 2026 Elite Valute | Privacy Policy | Contact Us</p>
</footer>

</body>
</html>
